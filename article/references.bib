  urldate = {2026-07-13},
  abstract = {The rapid expansion of social media sites has greatly accelerated the spread of faked images and videos and has triggered damaging issues regarding trust, security and information authenticity. Conventional methods of detection are usually unable to counter the ingenuity of contemporary forgery methods like deepfakes, image splicing, and video editing. Over the last decade, machine learning has proven to be a pivotal tool for identifying and countering manipulated content by detecting subtle patterns and anomalies often overlooked by humans. This review provides an extensive synthesis of recent advancements in machine learning and transformer-based techniques designed for detecting manipulated images and videos on social media platforms. Various strategies, ranging from supervised and unsupervised approaches to deep learning and transformer-driven models, are evaluated with respect to accuracy, computational efficiency, and their ability to generalize in real-world environments. Benchmark datasets and commonly employed evaluation metrics are highlighted, and the comparative performance of state-of-the-art detection models is analyzed. Challenges that continue to hinder progress, such as class imbalance, adversarial modifications, and limitations in cross-domain transferability, are discussed in detail.},
  keywords = {/unread,Accuracy,Benchmark testing,Computational efficiency,Computational modeling,Deep learning,Deepfake detection,Deepfakes,Fake image detection,Machine learning,Multimedia misinformation,Reviews,Social media forensics,Social networking (online),Transformers,Visualization},
