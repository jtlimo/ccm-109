  source = {Scopus},
  keywords = {/unread,Computational modeling,Computational modelling,Deep learning,Deepfake detection,Digital forensics,digital media forensics,Digital medium forensic,Digital storage,E-learning,Face,Faces,Fake detection,Image manipulation,Information integrity,Measurement,systematic literature review,Systematic literature review,Video,Video manipulations,video or image manipulation,Videos,Web pages,Web-page,Websites},
