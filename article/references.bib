@article{qureshiSystematicReviewDeep2024,
  title = {Systematic Review of Deep Learning Solutions for Malware Detection and Forensic Analysis in {{IoT}}},
  author = {Qureshi, Siraj Uddin and He, Jingsha and Tunio, Saima and Zhu, Nafei and Nazir, Ahsan and Wajahat, Ahsan and Ullah, Faheem and Wadud, Abdul},
  year = 2024,
