  pages = {100926},
  issn = {1574-0137},
  doi = {10.1016/j.cosrev.2026.100926},
  url = {https://www.sciencedirect.com/science/article/pii/S1574013726000353},
  urldate = {2026-07-14},
  abstract = {The Sailfish Optimizer (SFO) is a nature-inspired metaheuristic algorithm introduced to solve complex optimization problems inspired by the swift and agile movements of sailfish in the ocean. SFO has gained significant attention owing to its unique mechanism of exploration and exploitation, transparent structure and high efficacy. It is imperative to analyse challenges, inherent weakness, and advantages of any metaheuristic algorithm before improving them for enhancing its performance. To this end, this review presents a structural analysis of 112 articles using SFO algorithm, highlighting its advancements, theoretical foundations, statistical evaluation and inherent weaknesses, which is critical in improving any metaheuristic algorithm like SFO. Moreover, a systematic analysis of literature reveals the distribution of SFO studies in solving diverse range of optimization problems, including machine learning and artificial intelligence problems (15 \%), engineering design problems (15 \%), followed by healthcare and diagnostic problems (13 \%), and network and communication challenges (12 \%). The comprehensive analysis revealed that the percentage of SFO articles in literature were classified as classical SFO (37\%), improved SFO (16\%), binary and multi-objective versions (6\%) and hybrid SFO (26\%). The SFO algorithm was evaluated on CEC 2020 benchmark suites and convergence results revealed its outperformance from five well-known algorithms with a mean ranking of 1.29. Additionally, we have summarized the SFO algorithm's performance metrics, advantages, and weaknesses. This state-of-the-art review outlines emerging challenges and future research avenues to guide continued evolution of SFO in solving real-world complex optimization challenges.},
  keywords = {/unread,Chaotic SFO,Machine learning,Sailfish Optimizer (SFO),SFO variants,Statistical evaluation},
