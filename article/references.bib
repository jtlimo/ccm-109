  url = {https://www.sciencedirect.com/science/article/pii/S2590005626002924},
  urldate = {2026-07-14},
  abstract = {This Systematic Literature Review (SLR) investigates the feasibility, accuracy, and applicability of state-of-the-art Remote Photoplethysmography (rPPG) technologies for estimating vital signs, including heart rate, blood pressure, and oxygen saturation. In this review, 38 studies have been examined in depth. The study evaluates the feasibility of rPPG for vital sign estimation, analyzes the accuracy of existing rPPG models, and identifies the deviation of these methods from ground truth data, typically obtained using PPG or Electrocardiography (ECG) sensors. Furthermore, it highlights the most frequent algorithms and examines their performance across diverse settings and populations. Despite the promising advancements, the review identifies significant gaps in current rPPG methodologies, particularly in terms of accuracy and consistency under varying environmental conditions. The findings reveal that plane-orthogonal-to-skin (POS), Independent Component Analysis (ICA), and color-space-based extraction remain the most frequently observed signal-processing components, appearing in approximately 53\% of the reviewed pipelines. However, in the majority of studies published after 2022, these methods are no longer used as standalone estimators but rather as preprocessing or feature stages inside deep-learning architectures, with end-to-end and hybrid deep-learning models accounting for approximately 60\% of the reviewed corpus and 74\% of studies published in 2023--2025. We present the engineering contribution as a set of concrete deployment recommendations that map application scenarios (telemedicine, neonatal/critical care, driver monitoring, clinical cardiovascular assessment, and digital forensics) to suitable sensor types, regions of interest, signal extraction methods, and validation practices. Future research should prioritize enhancing the robustness and generalizability of methods across diverse real-world scenarios, not just fixed datasets. Existing approaches frequently face challenges such as motion artifacts, changes in ambient lighting conditions, low-resolution data, and variations in skin tone that need to be considered in the future.},
  keywords = {/unread,Heart rate monitoring,Remote photoplethysmography,Telemedicine,Vital signs from video},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Shahmirzadi et al. - 2026 - Remote photoplethysmography for camera-based vital sign estimation A systematic literature review,.pdf}
}

