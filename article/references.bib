  doi = {10.1109/DELCON68055.2025.11400058},
  abstract = {The rise of digital platforms and over-the-top (OTT) services has significantly transformed Hindi cinema's thematic scope, linguistic authenticity, and representation patterns. This study introduces the Digital-Era SocialConsciousness Index (DISCI), a composite framework combining Sensitive-Theme Intensity, Language Realism Score (LRS), Representation Equity, and Censorship Freedom metrics, to systematically evaluate the social inclusivity and realism of Hindi films. Adopting a mixed-method approach, we integrate a structured literature survey with empirical analysis of 50 Hindi films released between 2015 and 2024 (25 OTT originals, 25 theatrical). Results show that OTT originals depict sensitive social themes in 68 \% of titles compared to 28 \% for theatrical releases (+40 pp). The average LRS is 0.72 for OTT versus 0.45 for theatrical, indicating 60 \% higher linguistic authenticity. Representation Equity scores are 0.81 for OTT and 0.62 for theatrical, a 30 \% improvement in inclusion of marginalized groups. Findings highlight OTT's role in driving socially conscious narratives while introducing new content-quality challenges. \copyright{} 2025 IEEE.},
  isbn = {979-8-3315-5864-2},
  langid = {english},
  keywords = {/unread,Digital Media,Digital-Era Social-Consciousness Index,Language Realism Score,nosource,OTT}
}

