@article{mahrSexualizedDeepfakesSociotechnical2026,
  title = {Sexualized Deepfakes as a Socio-Technical Continuation of Gendered Power},
  author = {Mahr, Dana},
  year = 2026,
  month = may,
  journal = {AI \& SOCIETY},
  issn = {1435-5655},
  doi = {10.1007/s00146-026-03080-z},
  url = {https://doi.org/10.1007/s00146-026-03080-z},
  urldate = {2026-05-14},
  abstract = {Sexualized deepfakes are frequently framed as a problem of deception, misinformation, or privacy. However, a growing body of scholarship has shown that the central harm of deepfake pornography does not primarily lie in viewers being deceived, but in the non-consensual creation and circulation of sexualized representations. Building on this insight, this article examines sexualized deepfakes as socio-technical mechanisms of gendered power. Drawing on science and technology studies and feminist media theory, it argues that deepfake pornography extends existing practices of image-based sexual abuse by weaponizing visual representation against women. The paper situates sexualized deepfakes within longer histories of visual domination and analyzes how digital platforms, AI infrastructures, and cultural norms amplify these harms. It shows that current governance approaches, including consent-based legal frameworks, victim-centered resilience strategies, and technical detection tools, address only partial dimensions of a fundamentally systemic problem. In response, the article proposes a consent-centered socio-technical framework for governing deepfake abuse that integrates platform accountability, legal reform, technical safeguards, and victim support. Understanding sexualized deepfakes as instruments of power rather than merely falsified media shifts the focus of governance from protecting authenticity toward protecting autonomy, dignity, and justice in the age of generative AI.},
  langid = {english},
  keywords = {Gendered power,Generative AI,Image-based sexual abuse,Sexualized deepfakes,Socio-technical governance,Visual coercion},
  file = {/home/jessicafileto/Zotero/storage/P9GKGBAC/Mahr - 2026 - Sexualized deepfakes as a socio-technical continuation of gendered power.pdf}
}

@inproceedings{majeedSurveyHybridGANTransformer2026a,
  title = {A {{Survey}} on {{Hybrid GAN-Transformer Models}} for {{Image Forgery Detection}}},
  booktitle = {Proceedings of the 2026 2nd {{International Conference}} on {{Computing}} and {{Emerging Sciences}}},
  author = {Majeed, Abbas Hamid and Perumbalath, Abdul jabbar P and P, Pushpalatha K},
  year = 2026,
  month = apr,
  series = {{{ICCES}} '26},
  pages = {86--90},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3797491.3797519},
  url = {https://dl.acm.org/doi/10.1145/3797491.3797519},
  urldate = {2026-07-13},
  abstract = {The rapid rise of AI-generated media has intensified the challenge of reliable image forgery detection in digital forensics. While Generative Adversarial Networks (GANs) excel at exposing the fine-grained artefacts and Transformers are powerful in modelling global semantic consistency, neither approach alone offers comprehensive robustness against evolving manipulation techniques. This survey systematically reviews and analyses the emerging class of hybrid GAN-Transformer architectures through a structured examination of recent literature. These models integrate the artefact sensitivity of GANs with the long-range contextual reasoning of Transformers. We propose a taxonomy encompassing four core design paradigms, sequential feature pipelines, adversarial co-evolution frameworks, hierarchical refinement models, and fully integrated end-to-end systems. The review covers the representative methods evaluated on widely used benchmark datasets, including CASIA, CoMoFoD, FaceForensics++, and Celeb-D. The comparative findings indicate that GAN--Transformer hybrids consistently outperform CNN-, GAN-, or Transformer-only baselines in terms of detection accuracy, cross-dataset generalisation, and localisation precision. Beyond the performance gains, the survey also highlights the open research challenges including generalisation to unseen manipulations, adversarial robustness, computational efficiency, interpretability, and the scarcity of diverse training datasets. By tracing the evolution from handcrafted features to CNNs, GANs, Transformers, and finally hybrid models, this work positions the GAN-Transformer hybrids as a convergent and promising paradigm for next-generation, explainable, and practically deployable image forgery detection systems.},
  isbn = {979-8-4007-2088-8},
  langid = {english},
  keywords = {/unread,duplicate},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Majeed et al. - 2026 - A Survey on Hybrid GAN-Transformer Models for Image Forgery Detection.pdf}
}

@article{malikDeepFakeDetectionHuman2022a,
  title = {{{DeepFake Detection}} for {{Human Face Images}} and {{Videos}}: {{A Survey}}},
