  pages = {98451--98484},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2026.3707321},
  url = {https://ieeexplore.ieee.org/document/11579308},
  urldate = {2026-07-14},
  abstract = {The explosive growth of user-generated content and the widespread availability of video editing tools have made video copying, tampering, and secondary creation increasingly common. As a result, Partial Video Copy Detection (PVCD) has become a core technical pillar for copyright protection, content moderation, and multimedia forensics. This article provides a systematic review of PVCD research and technological evolution, and organizes the field into a unified technical framework that covers both traditional and deep learning-based approaches. Traditional methods mainly follow three pathways: keyframe retrieval, local feature sequence matching, and video fingerprint generation. These methods balance robustness and retrieval efficiency in different ways. In contrast, deep learning approaches shift from handcrafted matching to semantic representation learning, using 2D/3D CNNs and Video Transformers for spatiotemporal modeling, often combined with metric learning and end-to-end localization. We also analyze the design characteristics and evolution of evaluation protocols for mainstream datasets such as MUSCLE-VCD, VCDB, VCSL, and DVSC23. Evaluation systems have evolved from simple segment matching to temporal-overlap quantification and comprehensive localization assessment. Finally, we summarize key challenges---computational efficiency, robustness to complex edits, and cross-scenario generalization---and outline promising directions including self-supervised learning, cross-modal retrieval, and large-model-driven semantic alignment. This review aims to serve as a systematic reference for future work in PVCD.},
  keywords = {/unread,Learning (artificial intelligence),Location awareness,Measurement,Modeling,Partial video copy detection,rejected,Sequences,Sequential analysis,Signal detection,spatio-temporal feature representation,temporal localization,Training,Transformers,video similarity retrieval,Videos},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Hu et al. - 2026 - A Review of Partial Video Copy Detection Technical Advances, Evaluation Frameworks, and Future Tren.pdf}
}

