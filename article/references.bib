  booktitle = {2025 {{IEEE International Joint Conference}} on {{Biometrics}} ({{IJCB}})},
  author = {Chivata, Jefferson David Rodriguez and Ghiani, Davide and La Cava, Simone Maurizio and Micheletto, Marco and Orr{\'u}, Giulia and Lama, Federico and Marcialis, Gian Luca},
