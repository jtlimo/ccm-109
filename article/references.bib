@article{mengReviewCoverlessSteganography2024,
  title = {A Review of Coverless Steganography},
  author = {Meng, Laijin and Jiang, Xinghao and Sun, Tanfeng},
  year = 2024,
  month = jan,
  journal = {Neurocomputing},
  volume = {566},
  pages = {126945},
  issn = {0925-2312},
  doi = {10.1016/j.neucom.2023.126945},
  url = {https://www.sciencedirect.com/science/article/pii/S0925231223010688},
  urldate = {2026-07-14},
  abstract = {With the enhancement of people's security awareness, transmitting secret information securely has gradually become a demand for the public. Steganography is a technology of representing secret information within another carrier, aiming at transmitting secret information without causing suspicion. Most of the traditional steganographic algorithms hide secret information by modifying the statistical characteristics, which will leave traces to the carriers. Although these modifications are too tiny to be distinguished by human eyes, they can be detected by steganalysis algorithms. Differently, coverless steganography, also written as steganography without embedding, accomplish the process of information hiding by constructing the relationship between secret information and carriers. Due to no modification to the carriers, all of the steganalysis algorithms are expired. In this paper, more than 90 papers are included to provide a review in coverless steganographic algorithms, covering the major development process of coverless image and video steganographic algorithms. The main contribution of the existing methods is summarized. Besides, the current general issues of capacity, robustness, and security are discussed adequately for both image and video algorithms. Especially, the security of coverless steganography is discussed for the first time from theoretical analysis to actual investigation in this review.},
  keywords = {/unread,Anti-steganalysis,Coverless steganography,Information hiding,Robustness,Security},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Meng et al. - 2024 - A review of coverless steganography.pdf}
}

@article{miraniSystematicLiteratureReview2026,
  title = {A Systematic Literature Review on Energy Efficiency in Serverless Environments: {{Taxonomy}}, Techniques, and Future Directions},
  shorttitle = {A Systematic Literature Review on Energy Efficiency in Serverless Environments},
  author = {Mirani, Maedeh and Azizi, Sadoon and {Ghobaei-Arani}, Mostafa},
  year = 2026,
  month = aug,
  journal = {Computers and Electrical Engineering},
  volume = {136},
  pages = {111212},
  issn = {0045-7906},
  doi = {10.1016/j.compeleceng.2026.111212},
  url = {https://www.sciencedirect.com/science/article/pii/S0045790626002843},
  urldate = {2026-07-14},
  abstract = {In recent years, serverless computing has become a popular paradigm in modern computing environments, as it relieves developers from the burden of infrastructure management and reduces the operational complexity of applications and allows providers to pack workloads more efficiently across shared infrastructure. However, despite many advantages, especially as applications grow larger and demand more resources, the energy consumption of serverless platforms has become a major concern. While various researches have addressed energy concerns in serverless environments, to the best of our knowledge, no prior study has systematically reviewed and classified these approaches in a comprehensive manner. Therefore, to identify, categorize and analyze the existing body of knowledge in this domain, this paper presents a systematic literature review of energy efficiency in serverless environments including cloud, edge and edge-cloud deployments. Based on a rigorous review methodology, the selected studies are organized into a structured taxonomy including four main categories: learning-based, heuristic-based, model-based, and framework-based approaches. Each category is thoroughly examined in terms of its methodological characteristics, performance metrics, evaluation tools, advantages, and limitations. The paper also highlights current challenges and open issues in the field, outlining future research directions to advance energy-efficient design and resource management in serverless environments. We believe this review can serve as a reference point for researchers and practitioners seeking to enhance energy-aware computing across cloud and edge infrastructures using serverless paradigms.},
  keywords = {/unread,Cloud/Edge computing,Energy efficiency,Function-as-a-Service (FaaS),Resource management,Serverless computing,Systematic literature review},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Mirani et al. - 2026 - A systematic literature review on energy efficiency in serverless environments Taxonomy, techniques.pdf;/home/jessicafileto/Zotero/storage/DPWT2MRH/S0045790626002843.html}
}

