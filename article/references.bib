  doi = {10.23919/IST-Africa67297.2025.11060472},
  abstract = {The increasing adoption of artificial intelligence (AI) in cyberattacks poses critical challenges to organizational cybersecurity as traditional defense mechanisms become increasingly obsolete. Despite this growing threat, there is limited systematic understanding of how organizations can effectively respond. This study conducts a systematic literature review to analyse organizational defense strategies against AI-driven cyber threats. We examined 26 peer-reviewed articles published between 2019 and 2024, selected from key databases, including Scopus, IEEE Xplore, Science Direct, and Google Scholar, using PRISMA methodology. We identified three primary defense mechanisms through thematic analysis: AI-enhanced threat detection systems, adaptive security frameworks, and human-AI collaborative approaches. Our findings indicate that organizations implementing AI-based defense systems showed a 40\% improvement in threat detection rates. However, 73\% of organizations needed help maintaining up-to-date AI models against evolving threats. The review reveals a critical need for dynamic defense architectures that combine real-time AI adaptation with robust human oversight. These findings contribute to theory and practice by providing a comprehensive framework for organizational resilience against AI-driven cyber threats. Future research should address the identified gaps in real-time threat response systems and explore the ethical implications of AI-driven cybersecurity measures.  \copyright{} 2025 IST-Africa Institute and Authors.},
  isbn = {978-1-905824-75-5},
  langid = {english},
  keywords = {/unread,Artificial Intelligence,Cybersecurity Resilience,Cybersecurity Threats,Malware Obfuscation,nosource},
