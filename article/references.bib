@inproceedings{jainDeepfakeSurveyDetection2025,
  title = {Deepfake {{Survey}}: {{Detection Methods}}, {{Challenges}} and {{Ethical Implications}}},
  shorttitle = {Deepfake {{Survey}}},
  booktitle = {2025 {{IEEE International Conference}} on {{Communication Networks}} and {{Computing}} ({{CNC}})},
  author = {Jain, Mayank and Chinnaiyan, R and Choudhary, Harshvardhan},
  year = 2025,
