@inproceedings{agustiyarLowLightFaceRecognition2025,
  title = {Low-{{Light Face Recognition}}: {{A Systematic Literature Review}}},
  shorttitle = {Low-{{Light Face Recognition}}},
  booktitle = {2025 12th {{International Conference}} on {{Information Technology}}, {{Computer}}, and {{Electrical Engineering}} ({{ICITACEE}})},
