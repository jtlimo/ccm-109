  shorttitle = {Explainable {{Deep Learning}} for {{Digital Image Forgery Detection}}},
  booktitle = {2026 {{International Conference}} on {{Artificial Intelligence}}, {{Computer}}, {{Data Sciences}} and {{Applications}} ({{ACDSA}})},
  author = {Qasim, Israa Mohsin and Obaid, Farah Abbas},
  year = 2026,
  month = feb,
  pages = {1--8},
  doi = {10.1109/ACDSA67686.2026.11467619},
  url = {https://ieeexplore.ieee.org/document/11467619},
  urldate = {2026-07-14},
  abstract = {Digital image credibility has recently become a major issue with the advent of generative AI, as sophisticated editing techniques, diffusion, and Generative Adversarial Network (GAN)-based models can create high-quality fakes that jeopardize media trust and legal verifications. In this review, we focus on recent developments in explainable deep learning of digital image forgery detection. For this, we performed a systematic review of more than 40 studies (2019-2025) that studied the embedding of interpretation techniques such as Grad-CAM, SHAP and LIME attention mechanisms in Convolutional Neural Network (CNN) or Transformer architectures. Meanwhile, robustness and reproducibility were evaluated through comparison with the benchmark datasets such as the Chinese Academy of Sciences Image Tampering Dataset (CASIA), Copy-Move Forgery Detection Dataset (CoMoFoD), FaceForensics++, ForgeryNet, and evaluation metrics. Experiments show that deep models can also achieve detection accuracy above 95 \%, but they are not cross-domain applicable, cannot scale to larger test datasets, and are not sufficiently interpretable. The study provides a taxonomy of explainable paradigms and indicates prospects towards lightweight architectures, multimodal reasoning, and standardised interpretability assessment for dependable digital image verification.},
  keywords = {/unread,Adversarial robustness Trustworthy AI,Attention mechanisms,Benchmark datasets,Circuits and systems,Deep learning,Deepfakes,Digital image forgery detection,Digital images,duplicate,Evaluation metrics,Explainable artificial intelligence (XAI),Filtering,Filters,Interpretability,Location awareness,LoRa,Pixel,Protocols,Saliency mapping,Videos},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Qasim e Obaid - 2026 - Explainable Deep Learning for Digital Image Forgery Detection A Systematic and Critical Review 1.pdf;/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Qasim e Obaid - 2026 - Explainable Deep Learning for Digital Image Forgery Detection A Systematic and Critical Review.pdf}
