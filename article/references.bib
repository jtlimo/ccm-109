  pages = {535--541},
  doi = {10.1109/CNC68716.2025.11484843},
  url = {https://ieeexplore.ieee.org/document/11484843},
  urldate = {2026-07-14},
  abstract = {Deepfake technologies, driven by rapid advances in deep generative modeling, pose significant challenges to digital authenticity, public trust, and institutional accountability. This paper offers a comprehensive synthesis of the deepfake detection landscape, integrating technical, forensic, and governance-oriented perspectives. Detection methodologies are systematically categorized into spatial-domain artifact analysis, temporal coherence modeling, frequency-spectrum forensics, and biometric signal--based verification, each reflecting distinct theoretical foundations and operational constraints. Widely used benchmark datasets are critically evaluated in terms of diversity, realism, and robustness, highlighting persistent gaps in cross-domain generalization and real-world representativeness. The study also examines the broader societal risks associated with synthetic media, including disruptions to information ecosystems, threats to individual privacy, and the amplification of disinformation. Although recent progress in convolutional, recurrent, and transformer-based architectures has strengthened detection performance, the escalating sophistication of GAN- and diffusion-based generators continues to erode the reliability of static countermeasures. These developments underscore the necessity of adaptive, multimodal detection pipelines supported by coherent regulatory frameworks. Foundational contributions in face-warping artifact detection are revisited to illustrate the core principles that have shaped subsequent advances in digital media forensics. By situating technical evolution within an ethical and policy-aware context, this study contributes an integrated perspective on safeguarding authenticity in an era of increasingly sophisticated synthetic media.},
  keywords = {/unread,Communication networks,Communication systems,Deepfake detection,deepfakes,Deepfakes,face manipulation,face warping artifacts,GAN detection,HTTP,Internetworking,Interoperability,Pixel,Protocols,Video equipment,Videos},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Jain et al. - 2025 - Deepfake Survey Detection Methods, Challenges and Ethical Implications.pdf}
}

