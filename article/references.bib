  shorttitle = {Visual {{Deepfake Detection}}},
  author = {Ur Rehman Ahmed, Naveed and Badshah, Afzal and Adeel, Hanan and Tajammul, Ayesha and Daud, Ali and Alsahfi, Tariq},
  year = 2025,
  journal = {IEEE Access},
  volume = {13},
