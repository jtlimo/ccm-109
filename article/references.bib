  shorttitle = {A {{Comprehensive Review}} of {{Deepfake Detection}}},
  booktitle = {2026 5th {{International Conference}} on {{Communication}}, {{Computing}} and {{Electronics Systems}} ({{ICCCES}})},
  author = {S, Pramila and Choubey, Snigdha Smita and R, Roja and N, Usha Rani and T, Sasikala and Raj, J. Joshua Daniel},
  year = 2026,
  month = jan,
  pages = {1223--1228},
  doi = {10.1109/ICCCES62661.2026.11436354},
  url = {https://ieeexplore.ieee.org/document/11436354},
  urldate = {2026-07-14},
  abstract = {Deepfakes have become a major concern due to their ability to create highly realistic manipulated videos that can mislead viewers and cause serious social and security issues. As these manipulations improve, detecting them reliably has become increasingly difficult. This paper reviews recent deepfake detection approaches with a specific focus on models that combine ResNeXt-101 for spatial feature extraction and Transformer-based networks for temporal analysis. The review highlights how these models can be improved through techniques such as data augmentation, feature fusion, regularization, and adversarial-resistant training. It also explains how accuracy, precision, and reliability can be enhanced through cross dataset testing, calibration methods, and strong validation practices. In addition, the paper summarizes common visual inconsistencies found in manipulated videos and discusses the limitations of older CNN-based methods that rely only on single-frame information. Overall, this work provides a clear overview of current progress, challenges, and practical strategies for building more accurate and dependable deepfake detection systems.},
