  abstract = {Network Intrusion Detection Systems (NIDS) protect crucial network and data resources by serving as the first line of defense against cyber threats. However, using deep learning (DL) in NIDS makes them highly vulnerable to adversarial attacks that affect their reliability. This paper presents a taxonomy and review of DL-based adversarial attacks and investigates the application of these classified attacks in the context of NIDS. We categorised attacks based on model knowledge, training-testing attack, invisibility metric, attack goal, and focus area. Furthermore, we explore DL-based adversarial attack defenses within NIDS, present evaluation metrics, benchmark datasets, and adversarial tools, and analyze existing commercial intrusion detection tools. Our analysis provides insights into deep learning-based NIDS approaches and emphasizes the challenges in strengthening their robustness against evolving cyberattacks. The study also highlights the need for future research to enhance NIDS's ability to prevent adversarial attacks and improve network security.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {/unread,Adversarial Attacks on Deep Learning-based Network Intrusion Detection Systems: A Taxonomy and Review,Junbin Gao,Md Mehedi Hasan,Md Zahidul Islam,Quazi Mamun,Rafiqul Islam,rejected,SSRN},
