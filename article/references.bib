  doi = {10.1109/ICICIS66182.2025.11313172},
  url = {https://ieeexplore.ieee.org/document/11313172},
  urldate = {2026-07-14},
  abstract = {The rapid progress of advanced generative techniques-including GANs and diffusion models-has made it possible to craft highly realistic synthetic and altered images. These increasingly convincing forgeries threaten the reliability of digital media and raise concerns related to misinformation, security, and public safety. In response, the domain of fake image detection has expanded significantly, producing a variety of detection strategies that operate in areas such as spatial analysis, frequency examination, and latent-space interpretation. This survey reviews seven key research studies published between 2021 and 2025 and traces the evolution of detection approaches from early CNN-based models to transformer architectures and inversion-based solutions adapted for diffusion-generated images. We organize these works based on their input domain, model type, and detection methodology, and we provide a comparative discussion of their performance, benefits, and limitations. The objective of this study is to help researchers and practitioners understand current trends in digital image forensics and support the development of more resilient detection solutions.},
  keywords = {/unread,Adaptation models,AI-generated Content Detection,Computer architecture,Deepfake,Diffusion Models,Digital Image Manipulation,Digital images,Fake Image Detection,Forgery,Frequency-domain analysis,GAN-generated Images,Generative AI,Image Forensics,Image Forgery,Latent Space Analysis,Market research,Surveys,Transformers,Vision Transformers,Watermarking},
  file = {/home/jessicafileto/Documents/ufabc/mestrado/Zotero/Abbas et al. - 2025 - A Survey on Fake Image Detection Methodologies Trends and Techniques.pdf}
}

